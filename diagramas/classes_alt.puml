@startuml classes
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam packageStyle rectangle

package "domain (Domínio)" {
    enum StatusSlot {
        LIVRE
        RESERVADO
    }

    enum StatusContratacao {
        CONFIRMADA
        CONCLUIDA
        CANCELADA
    }

    class Servico {
        +id: str
        +prestador_id: str
        +titulo: str
        +descricao: str
        +categoria: str
        +valor: float
        +slots: List<SlotDisponibilidade>
        +adicionar_slot(slot: SlotDisponibilidade): void
        +buscar_slot(slot_id: str): SlotDisponibilidade
        +obter_slots_livres(): List<SlotDisponibilidade>
        +validar_contratante(solicitante_id: str): void
    }

    class SlotDisponibilidade {
        +id: str
        +servico_id: str
        +inicio: datetime
        +fim: datetime
        +status: StatusSlot
        +esta_livre(): bool
        +reservar(): void
        +liberar(): void
    }

    class Contratacao {
        +id: str
        +servico_id: str
        +slot_id: str
        +solicitante_id: str
        +prestador_id: str
        +status: StatusContratacao
        +criado_em: datetime
        +avaliacao: Optional<Avaliacao>
        +concluir(): void
        +cancelar(): void
        +registrar_avaliacao(nota: int, comentario: str): Avaliacao
    }

    class Avaliacao {
        +id: str
        +contratacao_id: str
        +nota: int
        +comentario: str
        +criado_em: datetime
        +validar_nota(): void
    }

    Servico "1" *-- "1..*" SlotDisponibilidade : possui >
    Contratacao "1" *-- "0..1" Avaliacao : contém >
    Contratacao ..> Servico : refere-se a >
    Contratacao ..> SlotDisponibilidade : reserva >
    SlotDisponibilidade --> StatusSlot
    Contratacao --> StatusContratacao
}

package "ports (Portas / Interfaces)" {
    interface ServicoRepository <<interface>> {
        +salvar(servico: Servico): void
        +buscar_por_id(servico_id: str): Optional<Servico>
        +listar_disponiveis(): List<Servico>
    }

    interface ContratacaoRepository <<interface>> {
        +salvar(contratacao: Contratacao): void
        +buscar_por_id(contratacao_id: str): Optional<Contratacao>
        +listar_por_usuario(usuario_id: str): List<Contratacao>
    }

    interface NotificadorPort <<interface>> {
        +notificar(destinatario: str, assunto: str, mensagem: str): void
    }
}

package "application (Casos de Uso)" {
    class SolicitarContratacaoUseCase {
        -servico_repo: ServicoRepository
        -contratacao_repo: ContratacaoRepository
        -notificador: NotificadorPort
        +executar(servico_id: str, slot_id: str, solicitante_id: str): Contratacao
    }

    class ConsultarServicosUseCase {
        -servico_repo: ServicoRepository
        +executar(apenas_com_slots_livres: bool): List<Servico>
    }

    SolicitarContratacaoUseCase --> ServicoRepository
    SolicitarContratacaoUseCase --> ContratacaoRepository
    SolicitarContratacaoUseCase --> NotificadorPort
    SolicitarContratacaoUseCase ..> Servico : valida e reserva
    SolicitarContratacaoUseCase ..> Contratacao : instancia
    ConsultarServicosUseCase --> ServicoRepository
}

package "adapters.outbound (Infraestrutura)" {
    class SqliteServicoRepository {
        -conn: Connection
        +salvar(servico: Servico): void
        +buscar_por_id(servico_id: str): Optional<Servico>
        +listar_disponiveis(): List<Servico>
    }

    class SqliteContratacaoRepository {
        -conn: Connection
        +salvar(contratacao: Contratacao): void
        +buscar_por_id(contratacao_id: str): Optional<Contratacao>
        +listar_por_usuario(usuario_id: str): List<Contratacao>
    }

    class EmailNotificador {
        -servidor_smtp: str
        +notificar(destinatario: str, assunto: str, mensagem: str): void
    }

    class NotificadorFake {
        +mensagens_enviadas: List<dict>
        +notificar(destinatario: str, assunto: str, mensagem: str): void
    }

    SqliteServicoRepository ..|> ServicoRepository
    SqliteContratacaoRepository ..|> ContratacaoRepository
    EmailNotificador ..|> NotificadorPort
    NotificadorFake ..|> NotificadorPort
}
@enduml
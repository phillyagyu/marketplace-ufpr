@startuml comunicacao
skinparam linestyle ortho
skinparam object {
    BackgroundColor White
    BorderColor Black
}

actor "Solicitante" as User
object "controller : MarketplaceController" as Ctrl
object "useCase : SolicitarContratacaoUseCase" as UC
object "servicoRepo : ServicoRepository" as SRepo
object "servico : Servico" as Serv
object "slot : SlotDisponibilidade" as Slot
object "contratacao : Contratacao" as Cont
object "contratacaoRepo : ContratacaoRepository" as CRepo
object "notificador : NotificadorPort" as Notif

User -down-> Ctrl : 1: solicitar_contratacao(servico_id, slot_id, solicitante_id)
Ctrl -down-> UC : 1.1: executar(servico_id, slot_id, solicitante_id)

UC -left-> SRepo : 1.2: buscar_por_id(servico_id)\n1.6: salvar(servico)
UC -down-> Serv : 1.3: validar_contratante(solicitante_id)\n1.4: buscar_slot(slot_id)
UC -down-> Slot : 1.5: reservar()
UC -right-> Cont : 1.5.1: <<create>>(dados_contratacao)
UC -right-> CRepo : 1.7: salvar(contratacao)
UC -up-> Notif : 1.8: notificar(prestador_id, assunto, msg)

@enduml
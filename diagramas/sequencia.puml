@startuml sequencia
autonumber
actor "Solicitante" as User
participant "controller:\nMarketplaceController" as Ctrl <<Inbound Adapter>>
participant "useCase:\nSolicitarContratacaoUseCase" as UC <<Controller GRASP>>
participant "servicoRepo:\nServicoRepository" as SRepo <<Outbound Port>>
participant "servico:\nServico" as Serv <<Information Expert>>
participant "slot:\nSlotDisponibilidade" as Slot <<Information Expert>>
participant "contratacao:\nContratacao" as Cont <<Aggregate Root>>
participant "contratacaoRepo:\nContratacaoRepository" as CRepo <<Outbound Port>>
participant "notificador:\nNotificadorPort" as Notif <<Outbound Port>>

User -> Ctrl : solicitar_contratacao(servico_id, slot_id, solicitante_id)
activate Ctrl

Ctrl -> UC : executar(servico_id, slot_id, solicitante_id)
activate UC

UC -> SRepo : buscar_por_id(servico_id)
activate SRepo
SRepo --> UC : servico
deactivate SRepo

UC -> Serv : validar_contratante(solicitante_id)
activate Serv
note right of Serv
  **Information Expert (GRASP)**:
  Valida RES01 (proibição de
  auto-contratação) no Domínio.
end note

alt solicitante_id == servico.prestador_id (Erro de Negócio: RES01)
    Serv --> UC : lança AutoContratacaoError
    UC --> Ctrl : propaga AutoContratacaoError
    Ctrl --> User : Exibe erro: "Prestador não pode contratar o próprio serviço"
else contratante válido
    Serv --> UC : ok
    deactivate Serv

    UC -> Serv : buscar_slot(slot_id)
    activate Serv
    Serv --> UC : slot
    deactivate Serv

    UC -> Slot : reservar()
    activate Slot
    note right of Slot
      **Information Expert (GRASP)**:
      Protege invariante de horário
      exclusivo (RES02 / ASR-02).
    end note

    alt slot.status != LIVRE (Erro de Negócio: RES02 / ASR-02)
        Slot --> UC : lança SlotIndisponivelError
        UC --> Ctrl : propaga SlotIndisponivelError
        Ctrl --> User : Exibe erro: "Horário selecionado já está reservado"
    else slot está LIVRE
        Slot -> Slot : status = StatusSlot.RESERVADO
        Slot --> UC : ok
        deactivate Slot

        create Cont
        UC -> Cont : <<create>>(id, servico_id, slot_id, solicitante_id, prestador_id, CONFIRMADA)

        UC -> SRepo : salvar(servico)
        activate SRepo
        SRepo --> UC : ok (slot atualizado para RESERVADO)
        deactivate SRepo

        UC -> CRepo : salvar(contratacao)
        activate CRepo
        CRepo --> UC : ok (contratação persistida)
        deactivate CRepo

        UC -> Notif : notificar(prestador_id, "Nova Contratação Confirmada - CampusHub", detalhes)
        activate Notif
        note right of Notif
          **Pure Fabrication / Protected Variations**:
          Disparo isolado via NotificadorPort (ASR-01)
          após persistência concluída com sucesso.
        end note
        Notif --> UC : ok
        deactivate Notif

        UC --> Ctrl : retorna contratacao
        Ctrl --> User : Confirma contratação criada (ID e horário reservado)
    end
end

deactivate UC
deactivate Ctrl
@enduml
